# Credential-file template only. Never put a real API key in this tracked file.
# Copy outside every Git checkout into a private Lain directory before editing.
# macOS: ~/Library/Application Support/Lain/actor.env (directory 0700, file 0600)
# Windows: %LOCALAPPDATA%\Lain\actor.env (protected owner-only ACLs)
# Replace the value below in your editor. Keep it unquoted, without export.
# Matches "secret_ref": "secret://env/actor" in actor.json.
LAIN_SECRET_ACTOR=REPLACE_WITH_YOUR_API_KEY
