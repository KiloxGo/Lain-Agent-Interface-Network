[Unit]
Description=Lain cloud Kernel (no local Worker runtime)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=lain
Group=lain
WorkingDirectory=/var/lib/lain
EnvironmentFile=/etc/lain/kernel.env
ExecStart=/srv/lain/current/laind
Restart=on-failure
RestartSec=10s
TimeoutStopSec=45s
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/lain
MemoryHigh=768M
MemoryMax=1G
CPUQuota=100%
TasksMax=128
LimitNOFILE=4096
LogNamespace=lain
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=multi-user.target
