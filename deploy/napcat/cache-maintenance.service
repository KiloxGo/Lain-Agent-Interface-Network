[Unit]
Description=Lain NapCat aged temporary image maintenance
ConditionPathIsDirectory=/var/lib/lain-napcat/qq/NapCat/temp

[Service]
Type=oneshot
# Root can enter private state; the helper checks the dedicated QQ account UID.
# Replace this numeric UID during explicit installation; never run unedited.
ExecStart=/usr/bin/python3 -B /srv/lain/ops/napcat_cache.py --expected-uid REPLACE_QQ_UID --apply
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateNetwork=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lain-napcat/qq/NapCat/temp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
MemoryMax=96M
CPUQuota=10%
TimeoutStartSec=60

