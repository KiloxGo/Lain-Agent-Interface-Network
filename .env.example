# Copy this file to lain-kernel/.env for local development.
# The process and /api/health can start without a key; /api/ready and /ws remain unavailable.
DEEPSEEK_API_KEY=

# Provider settings.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECS=180
DEEPSEEK_MAX_OUTPUT_TOKENS=4096

# Kernel settings. Relative paths are resolved against the startup directory and
# normalized to absolute paths during configuration loading.
LAIN_BIND_ADDR=127.0.0.1:3000
LAIN_SYSTEM_PROMPT=prompts/lain_system.md
# Optional; defaults to the current user's ~/.lain directory.
# LAIN_DATA_DIR=C:\path\to\private\lain-data
LAIN_SHUTDOWN_TIMEOUT_SECS=10
LAIN_MAX_MESSAGE_BYTES=65536
